/**
 * TypeScript Node 配置文件
 * 
 * 功能说明：
 * - 为 Vite 配置文件提供类型支持
 * - 包含 Vite 客户端类型声明
 */

{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "vite.config.ts"
  ]
}